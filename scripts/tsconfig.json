{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Node code, so no DOM and no JSX. `URL` and friends come from
    // @types/node, and anything that reaches for `document` here is a mistake
    // this catches.
    "lib": ["ESNext"],
    "types": ["node"]
  },
  "include": ["."]
}
