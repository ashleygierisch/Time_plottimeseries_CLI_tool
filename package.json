{
  "name": "plottimeseries",
  "version": "1.0.0",
  "description": "A Node.js project to visualize time series data from CSV files using React and D3.js. This project provides both a rich development environment and a standalone CLI utility for generating reports.",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "node scripts/plot-csv.ts",
    "build:standalone": "node scripts/build-standalone.ts",
    "validate": "node scripts/validate.ts",
    "lint": "eslint src scripts eslint.config.js --max-warnings=0",
    "typecheck": "tsc --noEmit -p src/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx' 'scripts/**/*.test.ts'",
    "test:update-snapshots": "UPDATE_SNAPSHOTS=1 tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx' 'scripts/**/*.test.ts'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "d3": "^7.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.7",
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "scriptc": "^0.0.35",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
